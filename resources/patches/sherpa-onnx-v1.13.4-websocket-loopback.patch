 void OfflineWebsocketServer::Run(uint16_t port) {
+  // WhisperWoof: loopback only (upstream listens on every interface), and
+  // no browser pages: a browser always sends Origin, the app never does.
+  server_.set_validate_handler([this](connection_hdl hdl) {
+    return server_.get_con_from_hdl(hdl)->get_origin().empty();
+  });
   server_.set_reuse_addr(true);
-  server_.listen(asio::ip::tcp::v4(), port);
+  server_.listen(
+      asio::ip::tcp::endpoint(asio::ip::address_v4::loopback(), port));
   server_.start_accept();
 }
 
